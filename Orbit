local function CreateFeature(name, subLabel, min, max, default, parent, featureKey)
	local Frame = Instance.new("Frame")
	Frame.Size = UDim2.new(1, 0, 0, 70)
	Frame.BackgroundTransparency = 1
	Frame.Parent = parent

	local Toggle = Instance.new("TextButton")
	Toggle.Size = UDim2.new(0, 14, 0, 14)
	Toggle.BackgroundColor3 = Theme.Header
	Toggle.Text = ""
	Toggle.AutoButtonColor = false
	Toggle.Parent = Frame
	Instance.new("UIStroke", Toggle).Color = Theme.Border
	
	Toggle.MouseButton1Click:Connect(function()
		Features[featureKey].Enabled = not Features[featureKey].Enabled
		TweenService:Create(Toggle, TweenInfo.new(0.1), {BackgroundColor3 = Features[featureKey].Enabled and Theme.Accent or Theme.Header}):Play()
	end)

	local NameLabel = Instance.new("TextLabel")
	NameLabel.Text = name
	NameLabel.Position = UDim2.new(0, 22, 0, 0)
	NameLabel.Size = UDim2.new(0, 100, 0, 14)
	NameLabel.BackgroundTransparency = 1
	NameLabel.TextColor3 = Theme.Text
	NameLabel.Font = Theme.Font
	NameLabel.TextSize = 13
	NameLabel.TextXAlignment = Enum.TextXAlignment.Left
	NameLabel.Parent = Frame

	local ValLabel = Instance.new("TextLabel")
	ValLabel.Text = subLabel .. ": " .. default
	ValLabel.Position = UDim2.new(0, 0, 0, 22)
	ValLabel.Size = UDim2.new(1, 0, 0, 20)
	ValLabel.BackgroundTransparency = 1
	ValLabel.TextColor3 = Theme.DarkText
	ValLabel.Font = Theme.Font
	ValLabel.TextSize = 12
	ValLabel.TextXAlignment = Enum.TextXAlignment.Left
	ValLabel.Parent = Frame

	local SliderBG = Instance.new("TextButton")
	SliderBG.Size = UDim2.new(1, -70, 0, 4)
	SliderBG.Position = UDim2.new(0, 0, 0, 50)
	SliderBG.BackgroundColor3 = Theme.Header
	SliderBG.Text = ""
	SliderBG.AutoButtonColor = false
	SliderBG.BorderSizePixel = 0
	SliderBG.Parent = Frame
	
	local SliderFill = Instance.new("Frame")
	local initPerc = (default - min) / (max - min)
	SliderFill.Size = UDim2.new(initPerc, 0, 1, 0)
	SliderFill.BackgroundColor3 = Theme.Accent
	SliderFill.BorderSizePixel = 0
	SliderFill.Parent = SliderBG

	local isSliding = false
	local activeSliderInput
	
	local function UpdateSlider(input)
		local barPos = SliderBG.AbsolutePosition.X
		local barSize = SliderBG.AbsoluteSize.X
		local perc = math.clamp((input.Position.X - barPos) / barSize, 0, 1)
		SliderFill.Size = UDim2.new(perc, 0, 1, 0)
		local val = min + (perc * (max - min))
		if max > 10 then val = math.floor(val) else val = math.round(val * 10) / 10 end
		ValLabel.Text = subLabel .. ": " .. val
		Features[featureKey].Value = val
	end

	SliderBG.InputBegan:Connect(function(input)
		if not isSliding and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
			isSliding = true
			activeSliderInput = input
			UpdateSlider(input)
			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					isSliding = false
					activeSliderInput = nil
				end
			end)
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if isSliding and input == activeSliderInput then UpdateSlider(input) end
	end)
end

-- Simplified Slider for Anim Speed (No Toggle)
local function CreateAnimSpeedSlider()
	local Frame = Instance.new("Frame")
	Frame.Size = UDim2.new(1, 0, 0, 50)
	Frame.BackgroundTransparency = 1
	Frame.Parent = CharContainer

	local ValLabel = Instance.new("TextLabel")
	ValLabel.Text = "animation speed: 1"
	ValLabel.Size = UDim2.new(1, 0, 0, 20)
	ValLabel.BackgroundTransparency = 1
	ValLabel.TextColor3 = Theme.DarkText
	ValLabel.Font = Theme.Font
	ValLabel.TextSize = 12
	ValLabel.TextXAlignment = Enum.TextXAlignment.Left
	ValLabel.Parent = Frame

	local SliderBG = Instance.new("TextButton")
	SliderBG.Size = UDim2.new(1, -70, 0, 4)
	SliderBG.Position = UDim2.new(0, 0, 0, 30)
	SliderBG.BackgroundColor3 = Theme.Header
	SliderBG.Text = ""
	SliderBG.BorderSizePixel = 0
	SliderBG.Parent = Frame
	
	local SliderFill = Instance.new("Frame")
	SliderFill.Size = UDim2.new(0.1, 0, 1, 0) -- Starts at speed 1 (1/10)
	SliderFill.BackgroundColor3 = Theme.Accent
	SliderFill.BorderSizePixel = 0
	SliderFill.Parent = SliderBG

	local isSliding = false
	local function UpdateSpeed(input)
		local p = math.clamp((input.Position.X - SliderBG.AbsolutePosition.X) / SliderBG.AbsoluteSize.X, 0, 1)
		SliderFill.Size = UDim2.new(p, 0, 1, 0)
		local val = math.round(p * 10 * 10) / 10
		ValLabel.Text = "animation speed: " .. val
		Features.AnimSpeed = val
	end

	SliderBG.InputBegan:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then isSliding = true UpdateSpeed(input) end end)
	UserInputService.InputChanged:Connect(function(input) if isSliding then UpdateSpeed(input) end end)
	UserInputService.InputEnded:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then isSliding = false end end)
end

