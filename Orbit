local Features = {
	VoidSpam = {Enabled = false, Value = -6700000},
	Orbit = {Enabled = false, Value = 250},
	AnimEnabled = false,
	SelectedAnim = "Solar system",
	AnimSpeed = 1
}

local AnimList = {
	"Solar system", "Zesty sturdy", "Floss", "67", "Push ups", "Take The L"
}
local AnimIDs = {
	["Solar system"] = "rbxassetid://92281817840531",
	["Zesty sturdy"] = "rbxassetid://136037836393259",
	["Floss"] = "rbxassetid://5917570207",
	["67"] = "rbxassetid://92707729249136",
	["Push ups"] = "rbxassetid://73630423562709",
	["Take The L"] = "rbxassetid://112884830175040"
}

local currentTrack = nil

local function PlayAnim()
	if currentTrack then currentTrack:Stop(); currentTrack = nil end
	if not Features.AnimEnabled then return end
	
	local char = Players.LocalPlayer.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local animator = hum and hum:FindFirstChildOfClass("Animator")
	
	if animator then
		local animation = Instance.new("Animation")
		local catalogId = AnimIDs[Features.SelectedAnim]
		
		local success, result = pcall(function()
			local objects = game:GetObjects(catalogId)
			for _, obj in pairs(objects) do
				if obj:IsA("Animation") then return obj.AnimationId end
				local found = obj:FindFirstChildWhichIsA("Animation", true)
				if found then return found.AnimationId end
			end
		end)

		animation.AnimationId = (success and result) or catalogId

		currentTrack = animator:LoadAnimation(animation)
		currentTrack.Looped = true
		currentTrack.Priority = Enum.AnimationPriority.Action4
		currentTrack:Play()
	end
end

Players.LocalPlayer.CharacterAdded:Connect(function()
    task.wait(1)
    if Features.AnimEnabled then PlayAnim() end
end)

-- Logic Loop
RunService.Heartbeat:Connect(function()
	local char = Players.LocalPlayer.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	local hum = char and char:FindFirstChildOfClass("Humanoid")

	if hrp and hum then
		-- Enhanced Map Death Fix
		if Features.VoidSpam.Enabled or Features.Orbit.Enabled then
			hum:SetStateEnabled(Enum.HumanoidStateType.Dead, false)
			hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
			hrp.Velocity = Vector3.new(0,0,0) -- Stop falling velocity
			if hum.Health > 0 and hum.Health < 1 then hum.Health = 100 end -- Instant health recovery
		else
			hum:SetStateEnabled(Enum.HumanoidStateType.Dead, true)
		end

		if Features.VoidSpam.Enabled then
			hrp.CFrame = CFrame.new(hrp.Position.X, Features.VoidSpam.Value, hrp.Position.Z)
		end
		if Features.Orbit.Enabled then
			local spread = Features.Orbit.Value
			hrp.CFrame = CFrame.new(hrp.Position + Vector3.new(math.random(-spread, spread), math.random(-spread, spread), math.random(-spread, spread)))
		end
        
        if currentTrack and currentTrack.IsPlaying then
            currentTrack:AdjustSpeed(Features.AnimSpeed)
        end
	end
end)

